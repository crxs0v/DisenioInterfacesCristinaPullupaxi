    private JButton[] botones =new JButton[9];
    private boolean jugador1=true;
    private int jugadas=0;
    
    public VentanaJuego() {
        setTitle("TresEnRaya Swing");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(300, 400);
        setLocationRelativeTo(null);
        
        inicializarComponentes();
    }
    private void inicializarComponentes(){
        JPanel panelBotones = new JPanel(new GridLayout(3, 3, 5, 5));
          
          for(int i=0;i<9;i++){
              JButton btn=new JButton();
              btn.setFocusable(false);
              btn.setOpaque(true);
              btn.setBorderPainted(false);
              btn.addActionListener(e->eventoJugar((JButton)e.getSource()));
              botones[i]=btn;
              panelBotones.add(btn);
          }
            add(panelBotones, BorderLayout.CENTER);
    }
    
    private void eventoJugar(JButton btnPulsado){
        if(jugador1){
           btnPulsado.setBackground(Color.BLUE);
        }else{
            btnPulsado.setBackground(Color.RED);
        } 
        
        
        jugadas++;
        if (hayGanador()) {
            String jugadorGanador = jugador1 ? "Jugador 1 (Azul)" : "Jugador 2 (Rojo)";
            JOptionPane.showMessageDialog(this, "Ha ganado el " + jugadorGanador );
            reiniciarJuego();
        } else if (jugadas == 9) {
            JOptionPane.showMessageDialog(this, "Empate. No ha ganado ninguno.");
            reiniciarJuego();
        } else {
          
           jugador1 = !jugador1;
        }
    }
    
    private boolean hayGanador() {
        //todas las combinaciones posibles
        int[][] combinaciones = {
            {0, 1, 2}, {3, 4, 5}, {6, 7, 8},
            {0, 3, 6}, {1, 4, 7}, {2, 5, 8}, 
            {0, 4, 8}, {2, 4, 6}             
        };

        Color colorTurnoActual = jugador1 ? Color.BLUE : Color.RED;

        for (int[] c : combinaciones) {
            if (botones[c[0]].getBackground().equals(colorTurnoActual) &&
                botones[c[1]].getBackground().equals(colorTurnoActual) &&
                botones[c[2]].getBackground().equals(colorTurnoActual)) {
                return true;
            }
        }
        return false;
    }
    private void reiniciarJuego() {
        for (JButton btn : botones) {
            btn.setEnabled(true);
            btn.setBackground(null);
        }
        jugador1 = true;
        jugadas = 0;
    }
    
    

